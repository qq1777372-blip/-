APP_NAME=Shop Record API
APP_ENV=development
APP_DEBUG=true

# Local development can keep SQLite.
# Production should switch to MySQL, for example:
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/shop_records?charset=utf8mb4
DATABASE_URL=sqlite:///D:/PY/FastAPIProject/shop_records.db
SQL_ECHO=false
AUTO_CREATE_SCHEMA=true

# Redis is used as the cache/session extension layer.
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=shop-records

# Security baseline for public deployment.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
# For HTTPS deployment keep this true; local HTTP debugging can temporarily set it to false.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict
TRUST_PROXY_HEADERS=false
PUBLIC_REGISTRATION_ENABLED=false
PUBLIC_REGISTRATION_ROLE=editor

# LAN launcher behavior:
# start_fastapi_lan.* binds to 0.0.0.0 by default.
# Set RS_ADMIN_ALLOW_LAN=0 to force localhost-only binding.
# Optional override:
# RS_ADMIN_PORT=8000

# Optional: overrides the locally generated account-password encryption key.
# Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If omitted, the app will create .runtime-secrets/account-password.key on first startup.
ACCOUNT_PASSWORD_ENCRYPTION_KEY=

.env
.runtime-secrets/
.venv/
__pycache__/
*.py[cod]
*.db
# WAL mode leaves these two beside every sqlite file; `*.db` misses them.
*.db-shm
*.db-wal
uploads/
backups/
deploy-backups/
.release/
.backend-test-*
frontend/node_modules/
frontend/dist/
frontend/src/**/*.bak*
frontend/.git.misplaced/
app-frontend/node_modules/
app-frontend/src/**/*.bak*
app-frontend-dist/
services/ai-workspace/files/
services/ai-workspace/legacy-assets/
services/ai-workspace/_*.log
app-frontend-native-dist/
app-frontend/test-results/
build-check.log
frontend/build-check.log
_spec_expenses.json
*.bak
app/**/*.bak-*
app/**/*.pre-*
app/**/*.rollback-*
.idea/

# local-only scratch: live backend snapshot and runtime script staging
_live_backend_snapshot_*/
_sycm_runtime_work/
_server_sycm_sync_button_*.js
*.before-*.db

# local-only scratch: dev-server logs and curl session files. _dev_cookies.txt
# holds a real session token, so it must never be committed.
_dev_cookies.txt
_dev_login.json
_*dev*.log
# `_*dev*.log` misses the launcher's own logs (_local_sycm_stack.err.log had
# grown to 110MB untracked), and `*.db` misses timestamped backup copies whose
# name does not end in .db.
_local_*.log
*.db.bak-*

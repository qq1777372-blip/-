# 环境变量清单（仅变量名与非敏感默认值，真实值不入库）
#
# 生产环境这些值不放在 .env，而是写在 systemd drop-in 里，见 deploy/systemd/。
# 本文件的作用是记录「服务需要哪些变量」，避免重建时漏配。
#
# 标记说明：
#   [必填-密钥]  没有它服务起不来或数据解不开，值只存在于服务器和你的密码管理器
#   [必填]       需要配置，但不是敏感值
#   [可选]       不配则用代码内默认值

# ---------- 运行环境 ----------
# [必填] production / development
APP_ENV=production
# [可选] 应用显示名，默认见 app/core/config.py
APP_NAME=
# [必填] 生产为 false
APP_DEBUG=false
# [必填] uvicorn 日志不缓冲
PYTHONUNBUFFERED=1

# ---------- 反向代理 ----------
# [必填] nginx 在前面时为 true，否则拿不到真实客户端 IP
TRUST_PROXY_HEADERS=true
# [必填] 当前服务器设为 false（nginx 已终止 TLS，见 drop-in https.conf）
SESSION_COOKIE_SECURE=false

# ---------- 加密密钥（不可再生，务必单独备份） ----------
# [必填-密钥] 加密 TOTP 二次验证密钥。更换会导致已有二次验证数据无法解密
AUTH_ENCRYPTION_KEY=
# 注意：账号密码字段的加密密钥不是环境变量，而是文件：
#   /srv/fastapiproject/.runtime-secrets/account-password.key  (44 字节)
# 该文件被 .gitignore 排除，丢失后店铺账号里所有已加密密码都无法解开。

# ---------- 生意参谋采集 ----------
# [必填-密钥] 采集端上传数据和领取任务的凭据，本地采集程序需配置同一个值
SYCM_UPLOAD_TOKEN=
# [可选] 生意参谋数据库路径，默认 /srv/fastapiproject/sycm_data/sycm_data.db
SYCM_DATA_DB_PATH=

# ---------- 钉钉 ----------
# [必填-密钥] 利润数据同步接口凭据
DINGTALK_PROFIT_SYNC_TOKEN=
# [必填-密钥] 机器人推送地址，含 access_token
DINGTALK_ROBOT_WEBHOOK=
# [可选] 机器人加签密钥，当前服务器未配置
DINGTALK_ROBOT_SECRET=

# ---------- 卡密 / 授权服务 ----------
# [必填] 本机 license_server 地址
LICENSE_SERVER_BASE_URL=http://127.0.0.1:15000
# [必填-密钥] 调用授权服务的管理令牌
LICENSE_ADMIN_TOKEN=

# ---------- 数据库与缓存 ----------
# [可选] 默认使用项目根目录下 shop_records.db (SQLite)
DATABASE_URL=
# [可选] 未配置则不启用 Redis
REDIS_URL=
REDIS_PREFIX=

# ---------- WpfApp1 相关辅助库（均为可选，不配用默认路径） ----------
PRODUCT_PARSE_CACHE_DB_PATH=
PUBLISH_FAILURE_REPORT_DB_PATH=
PUBLISH_FAILURE_REPORT_READER_USERNAMES=
RULE_CATALOG_DB_PATH=

# ---------- 其他 ----------
# [可选] 手机端 App 公网入口，用于生成分享链接
PUBLIC_APP_BASE_URL=

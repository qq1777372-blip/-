# nginx 站点配置模板 —— 对应服务器 /etc/nginx/sites-available/xiaoxu.conf
#
# 用途：记录反向代理拓扑，便于重建服务器。证书路径由 certbot 生成，不在本仓库内。
# 采集自香港生产机 152.32.174.85（2026-08-05），仅结构，无凭据。
#
# 端口分工：
#   8000  —— 本项目 FastAPI（fastapiproject.service）
#   15000 —— 卡密/授权服务（license_server）
#   18000 —— 旧软件管理 API，经 SSH 隧道转发到 121.196.150.21
#   18080 —— WpfApp1 安装包分发（traditional 更新源）

server {
    listen 80;
    listen [::]:80;
    server_name xiaoxu666.asia www.xiaoxu666.asia;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# www 子域：仅保留两个直连路径，其余 301 到主域
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.xiaoxu666.asia;

    ssl_certificate     /etc/letsencrypt/live/xiaoxu666.asia/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/xiaoxu666.asia/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location ^~ /software/ {
        proxy_pass http://127.0.0.1:18000;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    location ^~ /wpfapp1/ {
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host xiaoxu666.asia;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    location / {
        return 301 https://xiaoxu666.asia$request_uri;
    }
}

# 主域
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name xiaoxu666.asia;

    ssl_certificate     /etc/letsencrypt/live/xiaoxu666.asia/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/xiaoxu666.asia/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 20m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy same-origin always;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location = /api/health {
        proxy_pass http://127.0.0.1:15000;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ^~ /api/license/ {
        proxy_pass http://127.0.0.1:15000;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    location ^~ /software/ {
        proxy_pass http://127.0.0.1:18000;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    location ^~ /wpfapp1/ {
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host xiaoxu666.asia;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    # 本项目：/ui、/app、/api/sycm 等全部由 FastAPI 处理
    location / {
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }
}

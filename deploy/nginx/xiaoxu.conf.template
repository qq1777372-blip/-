# nginx 站点配置模板 —— 对应服务器 /etc/nginx/sites-available/xiaoxu.conf
#
# 用途：记录反向代理拓扑，便于重建服务器。证书路径由 certbot 生成，不在本仓库内。
# 采集自香港生产机 152.32.174.85（2026-08-05），仅结构，无凭据。
#
# 端口分工：
#   8000  —— 本项目 FastAPI（fastapiproject.service）
#   15000 —— 卡密/授权服务（license_server）
#   18000 —— 旧软件管理 API，经 SSH 隧道转发到 121.196.150.21
#   18080 —— WpfApp1 安装包分发（traditional 更新源）

map $http_origin $native_app_cors_origin {
    default "";
    "capacitor://localhost" $http_origin;
    "ionic://localhost" $http_origin;
}

server {
    listen 80;
    listen [::]:80;
    server_name xiaoxu666.asia www.xiaoxu666.asia;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# www 子域：仅保留两个直连路径，其余 301 到主域
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.xiaoxu666.asia;

    ssl_certificate     /etc/letsencrypt/live/xiaoxu666.asia/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/xiaoxu666.asia/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location ^~ /software/ {
        proxy_pass http://127.0.0.1:18000;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    location ^~ /wpfapp1/ {
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host xiaoxu666.asia;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    location / {
        return 301 https://xiaoxu666.asia$request_uri;
    }
}

# 主域
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name xiaoxu666.asia;

    ssl_certificate     /etc/letsencrypt/live/xiaoxu666.asia/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/xiaoxu666.asia/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 20m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy same-origin always;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
        try_files $uri =404;
    }

    location = /api/health {
        proxy_pass http://127.0.0.1:15000;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ^~ /api/license/ {
        proxy_pass http://127.0.0.1:15000;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    location ^~ /software/ {
        proxy_pass http://127.0.0.1:18000;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    location ^~ /wpfapp1/ {
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host xiaoxu666.asia;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    # 知识问答（知识库）—— 独立服务 knowledge-base.service，监听 127.0.0.1:8765，
    # 运行目录 /srv/knowledge-base。它不是本项目 FastAPI 的一部分。
    #
    # 这三个 location 必须存在。缺少它们时 /knowledge/ 和 /knowledge-api/ 会落到
    # 下面的 `location /`，被 FastAPI 当成未知路由返回 {"detail":"Not Found"}，
    # 前端「知识问答」页面因此全部 404。
    #
    # 鉴权：知识库服务自身不校验登录，访问控制完全依赖这里的 auth_request，
    # 由本项目的 /auth/me 判定会话是否有效。删掉 auth_request 会让整个知识库公开。
    location = /__knowledge_auth {
        internal;
        proxy_pass http://127.0.0.1:8000/auth/me;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Original-URI $request_uri;
    }

    location = /knowledge {
        return 302 /knowledge/;
    }

    # 用 proxy_pass 而不是 alias /srv/knowledge-base/public/：文档正文图片的路径形如
    # alidocs_images/<hash>/001.png，只存在于服务运行目录，不在 public/ 里。
    # 用 alias 时页面能打开但所有配图 404。
    location ^~ /knowledge/ {
        auth_request /__knowledge_auth;
        proxy_pass http://127.0.0.1:8765/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_buffering off;
        add_header Cache-Control "no-cache";
    }

    # 前端调用 /knowledge-api/<name>，服务实际路径是 /api/<name>，尾部斜杠负责改写。
    # 问答要等模型返回，超时给到 300s。
    location ^~ /knowledge-api/ {
        auth_request /__knowledge_auth;
        proxy_pass http://127.0.0.1:8765/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }

    # 新 AI 工作台独立服务。与旧知识问答分开部署和存储。
    location = /__ai_workspace_auth {
        internal;
        proxy_pass http://127.0.0.1:8000/auth/me;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Original-URI $request_uri;
    }

    location ^~ /ai-api/ {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin $native_app_cors_origin always;
            add_header Access-Control-Allow-Credentials "true" always;
            add_header Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS" always;
            add_header Access-Control-Allow-Headers $http_access_control_request_headers always;
            add_header Access-Control-Max-Age 86400 always;
            return 204;
        }
        add_header Access-Control-Allow-Origin $native_app_cors_origin always;
        add_header Access-Control-Allow-Credentials "true" always;
        add_header Vary Origin always;
        auth_request /__ai_workspace_auth;
        auth_request_set $ai_workspace_user $upstream_http_x_authenticated_user;
        auth_request_set $ai_workspace_role $upstream_http_x_authenticated_role;
        proxy_pass http://127.0.0.1:8766/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Authenticated-User $ai_workspace_user;
        proxy_set_header X-Authenticated-Role $ai_workspace_role;
        proxy_set_header X-Workspace-User "";
        proxy_set_header X-Workspace-Role "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    # 本项目：/ui、/app、/api/sycm 等全部由 FastAPI 处理
    location / {
        proxy_pass http://127.0.0.1:8000;
        include /etc/nginx/proxy_params;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }
}
